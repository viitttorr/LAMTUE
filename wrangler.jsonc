{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "d1_databases": [
    {
      "binding": "lamtue_db",
      "database_name": "lamtue-db",
      "database_id": "0f085810-c53f-4438-b919-c4c098868513"
    }
  ],
  "r2_buckets": [
    {
      "binding": "lamtue_arquivos",
      "bucket_name": "lamtue-arquivos"
    }
  ],
  "vars": {
    "RUNTIME": "cloudflare"
  }
}
