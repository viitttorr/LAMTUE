# ── LAMTUE Portal — variáveis de ambiente ──────────────────────────
# Copie este arquivo para .env e preencha os valores.

# Chave usada para assinar as sessões de login (troque por algo aleatório)
SESSION_SECRET=troque-por-uma-chave-secreta-longa

# ── Simulados por IA (API da Anthropic) ────────────────────────────
# Sem esta chave, os simulados usam apenas o banco de questões interno.
ANTHROPIC_API_KEY=

# ── E-mail (SMTP) ──────────────────────────────────────────────────
# Para Gmail: smtp.gmail.com, porta 465, com "senha de app".
# Sem SMTP configurado, os e-mails ficam registrados como "não configurado".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LAMTUE <lamtue@exemplo.com>"

# URL pública do portal (usada nos e-mails)
PUBLIC_URL=http://localhost:3000
